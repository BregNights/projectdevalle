# Copie este arquivo para .env e preencha os valores reais. Nunca commite o .env.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=projectdevalle
DB_USER=
DB_PASSWORD=

GOOGLE_MAPS_API_KEY=

# Login social (RF06) — client ID criado no Google Cloud Console.
# Deixar em branco desativa o botão de login social sem impedir o restante do sistema de subir.
GOOGLE_OAUTH_CLIENT_ID=

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Se definidas, um usuário Administrador é criado automaticamente no primeiro start (idempotente).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
