# Copie este arquivo para .env e preencha os valores reais. Nunca commite o .env.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=projectdevalle
DB_USER=
DB_PASSWORD=

GOOGLE_MAPS_API_KEY=

# Login social (RF06) — client ID criado no Google Cloud Console.
# Deixar em branco desativa o botão de login social sem impedir o restante do sistema de subir.
GOOGLE_OAUTH_CLIENT_ID=

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Se definidas, um usuário Administrador é criado automaticamente no primeiro start (idempotente).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# RNF06 — chave AES-256 para criptografar documentos e dados bancários no banco. Gere com:
#   openssl rand -base64 32
# Guarde com segurança: sem ela, os dados já gravados não podem ser lidos.
DATA_ENCRYPTION_KEY=

# RF04/RF07 — pasta dos arquivos enviados (fotos, documentos, comprovantes).
APP_STORAGE_DIR=./data/uploads

# RF06 — SMTP para e-mails (recuperação de senha). Sem MAIL_HOST, os e-mails não são enviados;
# no profile dev, o conteúdo aparece no log.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=nao-responda@projectdevalle.com.br
# Endereço do frontend, usado nos links enviados por e-mail.
FRONTEND_URL=http://localhost:5173
